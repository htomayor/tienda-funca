# ============================================
# AUTENTICACIÓN Y SEGURIDAD
# ============================================

from utils.auth import authenticate_user, login_required, hash_password, verify_password
from flask import session, flash, redirect, url_for, request, render_template_string
import secrets

@app.route('/login', methods=['GET', 'POST'])
def login_page():
    if request.method == 'POST':
        username = request.form['username']
        password = request.form['password']
        
        user = authenticate_user(username, password)
        if user:
            session['user'] = user['nombre']
            session['user_id'] = user['id']
            session['rol'] = user['rol']
            session['username'] = user['username']
            
            # Actualizar last_login
            conn = get_db_connection()
            if conn:
                cur = conn.cursor()
                cur.execute("UPDATE usuarios SET last_login = CURRENT_TIMESTAMP WHERE id = %s", (user['id'],))
                conn.commit()
                cur.close()
                conn.close()
            
            flash(f'Bienvenido {user["nombre"]}', 'success')
            next_page = request.args.get('next')
            return redirect(next_page or '/')
        else:
            flash('Usuario o contraseña incorrectos', 'danger')
    
    return render_template('login.html')

@app.route('/logout')
def logout():
    session.clear()
    flash('Sesión cerrada correctamente', 'info')
    return redirect(url_for('login_page'))

