@app.route('/api/usuarios', methods=['GET'])
@login_required(roles=['admin'])
def get_usuarios():
    conn = get_db_connection()
    if not conn:
        return jsonify({'error': 'Error de conexión'}), 500
    
    try:
        cur = conn.cursor()
        cur.execute("SELECT id, username, nombre, email, rol, activo, last_login FROM usuarios ORDER BY id")
        usuarios = cur.fetchall()
        colnames = [desc[0] for desc in cur.description]
        result = [dict(zip(colnames, row)) for row in usuarios]
        cur.close()
        conn.close()
        return jsonify(result)
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/api/usuarios/<int:usuario_id>', methods=['GET'])
@login_required(roles=['admin'])
def get_usuario(usuario_id):
    conn = get_db_connection()
    if not conn:
        return jsonify({'error': 'Error de conexión'}), 500
    
    try:
        cur = conn.cursor()
        cur.execute("SELECT id, username, nombre, email, rol, activo FROM usuarios WHERE id = %s", (usuario_id,))
        usuario = cur.fetchone()
        colnames = [desc[0] for desc in cur.description]
        result = dict(zip(colnames, usuario))
        cur.close()
        conn.close()
        return jsonify(result)
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/api/usuarios', methods=['POST'])
@login_required(roles=['admin'])
def create_usuario():
    data = request.json
    conn = get_db_connection()
    if not conn:
        return jsonify({'error': 'Error de conexión'}), 500
    
    try:
        cur = conn.cursor()
        
        # Verificar si usuario existe
        cur.execute("SELECT id FROM usuarios WHERE username = %s", (data['username'],))
        if cur.fetchone():
            return jsonify({'error': 'El usuario ya existe'}), 400
        
        # Crear hash de contraseña
        password_hash = hash_password(data['password']) if data.get('password') else hash_password(data['username'] + '123')
        
        cur.execute("""
            INSERT INTO usuarios (username, password_hash, nombre, email, rol, activo)
            VALUES (%s, %s, %s, %s, %s, %s) RETURNING id
        """, (data['username'], password_hash, data['nombre'], data.get('email'), data['rol'], data['activo']))
        
        usuario_id = cur.fetchone()[0]
        conn.commit()
        cur.close()
        conn.close()
        
        return jsonify({'id': usuario_id, 'message': 'Usuario creado'}), 201
    except Exception as e:
        conn.rollback()
        return jsonify({'error': str(e)}), 500

@app.route('/api/usuarios/<int:usuario_id>', methods=['PUT'])
@login_required(roles=['admin'])
def update_usuario(usuario_id):
    data = request.json
    conn = get_db_connection()
    if not conn:
        return jsonify({'error': 'Error de conexión'}), 500
    
    try:
        cur = conn.cursor()
        
        query = "UPDATE usuarios SET nombre = %s, email = %s, rol = %s, activo = %s"
        params = [data['nombre'], data.get('email'), data['rol'], data['activo']]
        
        if data.get('password') and data['password'].strip():
            password_hash = hash_password(data['password'])
            query += ", password_hash = %s"
            params.append(password_hash)
        
        query += " WHERE id = %s"
        params.append(usuario_id)
        
        cur.execute(query, params)
        conn.commit()
        cur.close()
        conn.close()
        
        return jsonify({'message': 'Usuario actualizado'})
    except Exception as e:
        conn.rollback()
        return jsonify({'error': str(e)}), 500

@app.route('/api/usuarios/<int:usuario_id>', methods=['DELETE'])
@login_required(roles=['admin'])
def delete_usuario(usuario_id):
    # No permitir eliminar el propio usuario
    if usuario_id == session.get('user_id'):
        return jsonify({'error': 'No puede eliminar su propio usuario'}), 400
    
    conn = get_db_connection()
    if not conn:
        return jsonify({'error': 'Error de conexión'}), 500
    
    try:
        cur = conn.cursor()
        cur.execute("DELETE FROM usuarios WHERE id = %s", (usuario_id,))
        conn.commit()
        cur.close()
        conn.close()
        return jsonify({'message': 'Usuario eliminado'})
    except Exception as e:
        conn.rollback()
        return jsonify({'error': str(e)}), 500

