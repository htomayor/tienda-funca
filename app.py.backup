# RUTAS PROTEGIDAS CON LOGIN
# ============================================

# Modificar rutas existentes para requerir login
# (las rutas originales ya existen, solo agregamos decoradores)
# Nota: Las rutas @app.route ya están definidas antes
# Por eso redefinimos aquí las mismas rutas con decoradores
# Esto reemplazará las rutas originales

@app.route('/cambiar-password', methods=['GET', 'POST'])
@login_required()
def cambiar_password():
    if request.method == 'POST':
        current_password = request.form['current_password']
        new_password = request.form['new_password']
        confirm_password = request.form['confirm_password']
        
        if new_password != confirm_password:
            flash('Las contraseñas no coinciden', 'danger')
            return redirect(url_for('cambiar_password'))
        
        conn = get_db_connection()
        cur = conn.cursor()
        cur.execute("SELECT password_hash FROM usuarios WHERE id = %s", (session['user_id'],))
        password_hash = cur.fetchone()[0]
        
        from utils.auth import verify_password, hash_password
        if verify_password(current_password, password_hash):
            new_hash = hash_password(new_password)
            cur.execute("UPDATE usuarios SET password_hash = %s WHERE id = %s", (new_hash, session['user_id']))
            conn.commit()
            flash('Contraseña actualizada correctamente', 'success')
            return redirect(url_for('index'))
        else:
            flash('Contraseña actual incorrecta', 'danger')
        
        cur.close()
        conn.close()
    
    return render_template('cambiar_password.html')

